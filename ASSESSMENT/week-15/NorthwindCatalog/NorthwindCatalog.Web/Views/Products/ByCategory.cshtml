@model List<NorthwindCatalog.Services.DTOs.ProductDto>

<h2>Products</h2>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>@item.ProductName</h5>
                    <p>Price: @item.UnitPrice</p>
                    <p>Units in Stock: @item.UnitsInStock</p>
                    <p>Inventory Value: @item.InventoryValue</p>
                </div>
            </div>
        </div>
    }
</div>