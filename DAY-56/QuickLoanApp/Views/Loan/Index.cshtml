@model List<QuickLoanApp.Models.Loan>

<h2>Loan List</h2>

<a asp-action="Add" class="btn btn-primary mb-2">Add Loan</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Borrower</th>
            <th>Lender</th>
            <th>Amount</th>
            <th>Settled</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var loan in Model)
    {
        <tr>
            <td>@loan.BorrowerName</td>
            <td>@loan.LenderName</td>
            <td>@loan.Amount</td>
            <td>@loan.IsSettled</td>
            <td>
                <a asp-action="Edit" asp-route-id="@loan.Id" class="btn btn-warning">Edit</a>
                @* <a asp-action="Delete" asp-route-id="@loan.Id" class="btn btn-danger">Delete</a> *@
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" onclick="setDeleteId(@loan.Id)">Delete</button>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
            </div>

            <div class="modal-body">
                Are you sure you want to delete this loan?
            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">No</button>

                <form id="deleteForm" method="post">
                    <button type="submit" class="btn btn-danger">Yes</button>
                </form>
            </div>

        </div>
    </div>
</div>

<script>
    function setDeleteId(id) {
        document.getElementById("deleteForm").action = "/Loan/Delete/" + id;
    }
</script>